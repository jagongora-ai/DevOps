{
  "cluster": "${CLUSTER}",
  "serviceName": "mysql",
  "taskDefinition": "bdget-mysql",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["${SUBNET1}", "${SUBNET2}"],
      "securityGroups": ["${SG_ID}"],
      "assignPublicIp": "ENABLED"
    }
  },
  "serviceConnectConfiguration": {
    "enabled": true,
    "namespace": "${NAMESPACE}",
    "services": [{
      "portName": "mysql-port",
      "discoveryName": "mysql",
      "clientAliases": [{ "port": 3306, "dnsName": "mysql" }]
    }],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/bdget",
        "awslogs-region": "${AWS_REGION}",
        "awslogs-stream-prefix": "sc-mysql"
      }
    }
  }
}
